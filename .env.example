# ============================================================
# Helmis — Environment Variables Template
# Copy this file to .env and fill in your actual values.
# NEVER commit .env to version control.
# ============================================================


# ------------------------------------------------------------
# Gemini API Keys
# Each key should come from a SEPARATE Google account/project
# to multiply free-tier quota via Hermes credential pooling.
# ------------------------------------------------------------
GEMINI_KEY_1=
GEMINI_KEY_2=
GEMINI_KEY_3=
GEMINI_KEY_4=
GEMINI_KEY_5=
GEMINI_KEY_6=


# ------------------------------------------------------------
# WAHA (WhatsApp HTTP API)
# ------------------------------------------------------------
# API key for authenticating requests to WAHA REST API
WAHA_API_KEY=helmis-secret-change-me

# Password for the WAHA web dashboard (http://localhost:3000/dashboard)
WAHA_DASHBOARD_PASSWORD=change-me
# Optional shared secret checked by Helmis webhook ingress.
WAHA_WEBHOOK_SECRET=
# Optional shared secret for the internal scheduler webhook.
SCHEDULER_WEBHOOK_SECRET=

# Internal URL used by mcp-waha to reach WAHA (Docker service name)
WAHA_BASE_URL=http://waha:3000

# Name of the WAHA session to create/use
WAHA_SESSION_NAME=helmis


# ------------------------------------------------------------
# Identity & User Mapping
# Format: country code + number, no spaces or symbols (e.g. 628123456789)
# ------------------------------------------------------------
# Primary Owner Name & Phone (Used for both Solo & Duo mode)
OWNER_NAME=Gilang
GILANG_PHONE=6281234567890

# (Optional) Partner Name & Phone (Only needed for Duo / Couple mode; leave blank if Solo)
PARTNER_NAME=Bunga
BUNGA_PHONE=6289876543210

# Phone number registered to the Helmis bot WhatsApp account
BOT_PHONE=6281987654321

# (Optional) WhatsApp Linked Device Identifiers (LIDs)
GILANG_LID=
BUNGA_LID=

# (Optional) Whitelisted Trio Group JID (e.g. 120363xxxxxxxxx@g.us)
TRIO_GROUP_JID=


# ------------------------------------------------------------
# MCP WAHA Server
# Internal port the MCP server listens on
# ------------------------------------------------------------
MCP_WAHA_PORT=8765


# ------------------------------------------------------------
# Helmis Agent
# Internal webhook port Helmis listens on for WAHA events
# ------------------------------------------------------------
HELMIS_WEBHOOK_PORT=8644


# ------------------------------------------------------------
# Timezone
# Used for scheduling, reminders, and morning briefings.
# ------------------------------------------------------------
TZ=Asia/Jakarta


# ------------------------------------------------------------
# (Optional) iLovePDF Cloud API
# For 100% genuine iLovePDF-grade PDF to Word (DOCX) conversions.
# Free tier gives 250 conversions/mo at https://developer.ilovepdf.com
# If omitted, Helmis uses its native high-fidelity local engine.
# ------------------------------------------------------------
ILOVEPDF_PUBLIC_KEY=
ILOVEPDF_SECRET_KEY=

# ------------------------------------------------------------
# (Optional) Tool chips footnote
# Append `↳ tool_name` chips to replies after mutating turns.
# Default off; no-fluff requests never get chips regardless.
# ------------------------------------------------------------
HELMIS_TOOL_CHIPS_ENABLED=0
